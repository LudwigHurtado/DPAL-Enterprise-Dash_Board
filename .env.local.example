# ─── DPAL Enterprise Dashboard — Environment Variables ───────────────────────
# Copy this file to .env.local (never commit .env.local to git).
# On Vercel: add these in Project → Settings → Environment Variables.

# ─── Backend base URL (Railway, Render, or local dev) ────────────────────────
# This is the root of your dpal-front-end/backend Express server.
# No trailing slash.
NEXT_PUBLIC_DPAL_API_BASE="https://your-backend.up.railway.app"

# For local development against the backend running on port 3001:
# NEXT_PUBLIC_DPAL_API_BASE="http://localhost:3001"

# ─── Admin secret ─────────────────────────────────────────────────────────────
# Must match the ADMIN_SECRET in the backend .env.
# Used as Bearer token for /api/admin/* endpoints.
NEXT_PUBLIC_DPAL_ADMIN_SECRET="change-this-in-production"

# ─── DPAL Evidence Studio (server-only) ───────────────────────────────────────
# Private renderer URL reachable by the Next.js server. Never prefix with NEXT_PUBLIC.
# Vercel cannot reach 127.0.0.1 on another machine; use a private deployed service URL.
DPAL_MEDIA_RENDERER_URL="http://127.0.0.1:8080"

# Optional x-api-key used by the reviewed private renderer deployment.
DPAL_MEDIA_RENDERER_API_KEY=""

# Timeout for health, create-task, status, and report verification calls.
# Asset streaming is not cut off by this value.
DPAL_MEDIA_RENDERER_TIMEOUT_MS="15000"

# Required in production. Protects render, status, asset, and report endpoints.
DPAL_MEDIA_STUDIO_ACCESS_TOKEN="replace-with-a-long-random-operator-token"

# Strongly recommended in production. Adds an HMAC-SHA256 signature to production reports.
# Use a long random secret stored only in the deployment secret manager.
DPAL_MEDIA_REPORT_SIGNING_KEY="replace-with-a-separate-long-random-signing-key"

# Backward-compatible legacy aliases are still accepted during migration:
# MONEYPRINTER_API_URL=""
# MONEYPRINTER_API_KEY=""
# MONEYPRINTER_REQUEST_TIMEOUT_MS=""

# ─── Optional: Supabase (if dashboard calls Supabase directly) ────────────────
# Usually the dashboard talks to the backend API, not Supabase directly.
# Only needed if you add server-side Supabase calls to Next.js API routes.
# NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="[ANON_KEY]"
